# CiN Cleaning frontend. In production set these in Vercel: Project Settings > Environment Variables.
# Only VITE_* values are exposed to the browser bundle, so never put secrets in VITE_* variables.

# API base (the DirectAdmin backend). Leave unset locally to use the Vite dev proxy below.
VITE_API_URL=https://api.cleanitneatly.com/api

# Optional: WebSocket URL for live updates. Defaults to wss://<API host>/ws when VITE_API_URL is absolute.
# VITE_WS_URL=wss://api.cleanitneatly.com/ws

# Optional: API used at build time to bake live SEO settings into pre-rendered pages (defaults to VITE_API_URL).
# PRERENDER_API_URL=https://api.cleanitneatly.com/api

# Local development only: where `npm run dev` proxies /api, /uploads, /pay and /ws.
# DEV_API_TARGET=http://127.0.0.1:3002

# Local only: used by `npm run generate:siteshots` (Imagen). Not needed on Vercel.
# GEMINI_API_KEY=
