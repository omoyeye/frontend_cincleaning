{
  "name": "cin-cleaning-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "CiN Cleaning website, client/staff/admin portals (Vite + React), deployed on Vercel.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate:siteshots": "node scripts/generate-siteshots.mjs"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@google/genai": "^1.40.0",
    "@types/node": "^22.19.10",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.2.4",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
